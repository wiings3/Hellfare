extends SceneTree
## Harlow vertical-slice integration: UI, scouting, role composition and persistent resolution.
## Never run outside CI because this test intentionally resets user:// saves.

func _initialize() -> void:
	if OS.get_environment("CI") != "true":
		push_error("Harlow tests must only run in CI.")
		quit(1)
		return
	call_deferred("_run")

func _run() -> void:
	var scene: PackedScene = load("res://scenes/main.tscn")
	assert(scene != null)
	var view: Control = scene.instantiate()
	root.add_child(view)
	view.game.reset_company()
	view._nav_to("harlow")
	assert(view.page == "harlow")
	assert(view.game.harlow.has("rotation"))
	assert(view.game.harlow.get("report", {}).is_empty())
	var first_rotation: int = int(view.game.harlow["rotation"])
	var started: String = view.game.harlow_send_scout()
	assert(started.begins_with("Scout dispatched"))
	assert(int(view.game.harlow["scout_finish"]) > 0)
	assert(view.game.harlow_send_scout().contains("already"))
	view.game.harlow["scout_finish"] = int(Time.get_unix_time_from_system()) - 2
	view.game.harlow_sync()
	assert(not (view.game.harlow["report"] as Dictionary).is_empty())
	assert(int(view.game.harlow["rotation"]) == first_rotation)
	view._refresh()
	var scout_level: int = int(view.game.harlow["scout_level"])
	assert(scout_level == 1)
	assert(view.game.hire("garrick").contains("joined"))
	assert(view.game.hire("oswin").contains("joined"))
	var crew: Array[String] = ["garrick", "oswin"]
	var stats: Dictionary = view.game.harlow_crew_stats(crew, "Balanced")
	assert(int(stats["miners"]) == 1)
	assert(int(stats["guards"]) == 1)
	assert(int(stats["capacity"]) == 3)
	assert(float(stats["success"]) > 0.1)
	var solo: Array[String] = ["garrick"]
	var solo_stats: Dictionary = view.game.harlow_crew_stats(solo, "Balanced")
	assert(float(stats["success"]) > float(solo_stats["success"]))
	view.harlow_view.selected.assign(crew)
	view.harlow_view.stance = "Balanced"
	view._refresh()
	view.harlow_view._dispatch()
	assert(view.game.missions.size() == 1)
	assert(view.game.free_crew() == 0)
	assert(str(view.game.missions[0]["region"]) == "harlow")
	var mission_cost: int = int(view.game.missions[0]["cost"])
	assert(mission_cost > 0)
	view._nav_to("hq")
	view._nav_to("harlow")
	var completed: int = view.game.complete_due(int(Time.get_unix_time_from_system()) + 1000)
	assert(completed == 1)
	assert(view.game.missions.is_empty())
	assert(view.game.reports.size() == 1)
	assert(view.game.reports[0].has("casualties"))
	assert(view.game.reports[0].has("extracted"))
	assert(view.game.complete_due(int(Time.get_unix_time_from_system()) + 1000) == 0)
	view._nav_to("ledger")
	view._select_report(0)
	view._nav_to("market")
	view._select_item("copper")
	assert(view.game.resources.has("copper"))
	view.game.save_game()
	var restored := MoneyMercsState.new()
	assert(int(restored.harlow["rotation"]) == first_rotation)
	assert(restored.reports.size() == 1)
	view.game.reset_company()
	assert(view.game.harlow.is_empty())
	print("Harlow Mines scout, planner, risk and persistence integration passed.")
	quit(0)
