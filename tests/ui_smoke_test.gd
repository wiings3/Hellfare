extends SceneTree
## Guild Ledger UI navigation/actions in CI; never touch an actual user's save.
func _initialize() -> void:
	if OS.get_environment("CI") != "true":
		push_error("CI only")
		quit(1)
		return
	call_deferred("_run")

func _run() -> void:
	var view: Control = load("res://scenes/journal/widgets/main.tscn").instantiate()
	root.add_child(view)
	assert(view.game != null)
	view.game.reset_company()
	view._nav_to("hq")
	assert(view.header_gold.text.contains("350"))
	view._open_recruitment()
	assert(view.page == "roster")
	assert(view.roster_tab == "recruits")
	view._hire("garrick")
	assert(view.game.crew.size() == 1)
	assert(view.roster_tab == "employed")
	view._nav_to("harlow")
	assert(view.page == "site" and view.selected_site == "harlow")
	view._nav_to("market")
	view._select_item("iron")
	view._nav_to("expeditions")
	view._select_region("lowlands")
	view._old_dispatch("lowlands")
	assert(view.game.missions.size() == 1)
	view._nav_to("ledger")
	assert(view.game.complete_due(int(Time.get_unix_time_from_system()) + 3600) == 1)
	view._refresh()
	assert(view.game.reports.size() == 1)
	view._nav_to("roster")
	view._nav_to("hq")
	view.game.reset_company()
	assert(view.game.hire("garrick").contains("joined"))
	view.game.gold = 0
	view._nav_to("hq")
	view._guild_work("garrick")
	assert(view.game.missions.size() == 1)
	assert(str(view.game.missions[0]["region"]) == "guild_work")
	assert(view.game.complete_due(int(Time.get_unix_time_from_system()) + 1000) == 1)
	view._nav_to("ledger")
	assert(str(view.game.reports[0]["region"]) == "Guild Work Order")
	view.game.reset_company()
	print("Guild Ledger UI navigation, guild work recovery, and legacy operations passed.")
	quit(0)
