func _init() -> void:
	for id in RESOURCE_ORDER:
		resources[id] = 0
	hall.item_name = item_ref_name
	load_game()

func load_game() -> void:
	if persist:
		GameSettings.carry_over(SAVE_PATH)
	if not persist or not FileAccess.file_exists(SAVE_PATH):
		return
	var file := FileAccess.open(SAVE_PATH, FileAccess.READ)
	if file == null:
		return
	var data: Variant = JSON.parse_string(file.get_as_text())
	if typeof(data) != TYPE_DICTIONARY:
		last_notice = "Save file unreadable. Started a new guild."
		return
	var state: Dictionary = data
	if int(state.get("version", 0)) != 1:
		last_notice = "Save version not recognized. Started a new guild."
		return
	gold = int(state.get("gold", 350))
	reputation = int(state.get("reputation", 0))
	expedition_slots = clampi(int(state.get("expedition_slots", 1)), 1, MAX_SLOTS)
	next_mission_id = maxi(1, int(state.get("next_mission_id", 1)))
	var saved_resources: Dictionary = state.get("resources", {})
	for id in RESOURCE_ORDER:
		resources[id] = maxi(0, int(saved_resources.get(id, 0)))
	for m in state.get("crew", []):
		if typeof(m) == TYPE_DICTIONARY:
			crew.append(m)
	for m in state.get("missions", []):
		if typeof(m) == TYPE_DICTIONARY:
			missions.append(m)
	for r in state.get("reports", []):
		if typeof(r) == TYPE_DICTIONARY:
			reports.append(r)
	harlow = state.get("harlow", {})
	next_item_id = maxi(1, int(state.get("next_item_id", 1)))
	relief_debt = maxi(0, int(state.get("relief_debt", 0)))
	relief_count = maxi(0, int(state.get("relief_count", 0)))
	for value in state.get("retired_ids", []):
		retired_ids.append(str(value))
	if state.get("tutorial") is Dictionary:
		tutorial = state["tutorial"]
	else:
		tutorial = {"step": "done" if not crew.is_empty() or not reports.is_empty() else "prologue"}
	for item in state.get("equipment_inventory", []):
		if typeof(item) == TYPE_DICTIONARY and Gear.exists(str(item.get("key", ""))):
			Gear.ensure_item(item)
			equipment_inventory.append(item)
	for key in state.get("blueprints", []):
		blueprints.append(str(key))
	for key in state.get("upgrades", []):
		upgrades.append(str(key))
	for merc in crew:
		Gear.ensure(merc)
		TradeSkills.ensure(merc)
		Mercs.migrate(merc)
	for h in state.get("heroes", []):
		if typeof(h) == TYPE_DICTIONARY:
			Gear.ensure(h)
			TradeSkills.ensure(h)
			heroes.append(h)
	hero_slots = clampi(int(state.get("hero_slots", 1)), 1, Heroes.MAX_SLOTS)
	next_hero_id = maxi(1, int(state.get("next_hero_id", heroes.size() + 1)))
	if not state.has("heroes"):
		_migrate_to_heroes()
	if state.get("crypt_cleared") is Dictionary:
		for k in state["crypt_cleared"]:
			crypt_cleared[str(k)] = int(state["crypt_cleared"][k])
	market.load_dict(state.get("market", {}))
	hall.load_dict(state.get("hall", {}))
	fallen.load_dict(state.get("fallen", {}))
	auction.load_dict(state.get("auction", {}))
	# Listings no longer exist: goods left in them go back to the warehouse.
	for listing in hall.legacy_listings:
		resources[str(listing["good"])] = int(resources.get(str(listing["good"]), 0)) + int(listing["left"])
	hall.legacy_listings.clear()
	last_notice = "Guild records restored."

func save_game() -> void:
	if not persist:
		return
	var file := FileAccess.open(SAVE_PATH, FileAccess.WRITE)
	if file == null:
		last_notice = "Unable to save guild records."
		return
	fallen.prune(GameClock.now())
	auction.prune(GameClock.now())
	var data := {
		"version": 1, "gold": gold, "reputation": reputation,
		"expedition_slots": expedition_slots, "next_mission_id": next_mission_id,
		"resources": resources, "crew": crew, "missions": missions, "reports": reports,
		"harlow": harlow, "equipment_inventory": equipment_inventory,
		"next_item_id": next_item_id, "relief_debt": relief_debt, "blueprints": blueprints, "upgrades": upgrades,
		"relief_count": relief_count, "retired_ids": retired_ids, "tutorial": tutorial,
		"heroes": heroes, "hero_slots": hero_slots, "next_hero_id": next_hero_id, "crypt_cleared": crypt_cleared,
		"market": market.to_dict(), "hall": hall.to_dict(), "fallen": fallen.to_dict(), "auction": auction.to_dict()
	}
	file.store_string(JSON.stringify(data, "\t"))

func region_by_id(id: String) -> Dictionary:
	for region in REGIONS:
		if region["id"] == id:
			return region
	return {}

## A named recruit as an applicant (skills, traits and the basic tool for their trade).
func recruit_by_id(id: String) -> Dictionary:
	for d in RECRUITS:
		if d["id"] != id:
			continue
		var skills: Dictionary = {}
		for trade in TradeSkills.TRADES:
			skills[trade] = TradeSkills.xp_for_level(int(d["level"]) if trade == str(d["focus"]) else 1)
		var person: Dictionary = {"id": d["id"], "name": d["name"], "skills": skills, "traits": (d["traits"] as Array).duplicate(),
			"hire": d["hire"], "wage": d["wage"], "share": d["share"], "kit": Mercs.STARTER_TOOL[d["focus"]],
			"skill": 8 + int(d["level"]), "kind": "recruit"}
		person["min_tier"] = Mercs.min_tier(person)
		return person
	return {}

## The company's reputation tier (see Mercs.TIERS).
func rep_tier() -> int:
	return Mercs.tier_for(reputation)

func merc_by_id(id: String) -> Dictionary:
	for merc in crew:
		if merc["id"] == id:
			return merc
	for h in heroes:
		if h["id"] == id:
			return h
	return {}

func is_available(merc: Dictionary) -> bool:
	return str(merc.get("mission_id", "")) == ""

## Who can be signed now: named mercenaries the company is reputable enough for, the
## half-hourly applicants (better ones at higher reputation) and contracts other guilds sell.
func recruitment_board() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	var tier: int = rep_tier()
	var now: int = GameClock.now()
	var people: Array[Dictionary] = []
	for d in RECRUITS:
		people.append(recruit_by_id(str(d["id"])))
	people.append_array(Mercs.generate_board(int(now / 1800.0), tier))
	people.append_array(Mercs.guild_contracts(int(now / float(Mercs.CONTRACT_EPOCH)), tier))
	for person in people:
		if int(person.get("min_tier", 0)) <= tier and merc_by_id(str(person["id"])).is_empty() and not _is_retired(person):
			result.append(person)
	return result

func _is_retired(candidate: Dictionary) -> bool:
	if retired_ids.has(str(candidate["id"])):
		return true
	# Generated contractors are new people each board: a fallen mercenary's name must not
	# rule out every later stranger who shares it (that emptied the board after ~260 deaths).
	if str(candidate["id"]).begins_with("candidate_"):
		return false
	for record in harlow.get("fallen", []):
		if str(record.get("name", "")) == str(candidate["name"]):
			return true
	return false

func _available_candidate(id: String) -> Dictionary:
	for candidate in recruitment_board():
		if str(candidate["id"]) == id:
			return candidate
	return {}

func hire(id: String) -> String:
	if not merc_by_id(id).is_empty():
		return "Already on your payroll."
	var candidate: Dictionary = _available_candidate(id)
	if candidate.is_empty():
		return "Recruit not found."
	if gold < int(candidate["hire"]):
		return "Not enough gold to hire this Hellfarer."
	if int(candidate.get("min_tier", 0)) > rep_tier():
		return "%s won't join a guild of your reputation." % str(candidate["name"])
	var merc: Dictionary = candidate.duplicate(true)
	merc["gear"] = 0
	merc["equipment"] = Gear.empty_equipment()
	var kit: String = str(merc.get("kit", ""))
	if Gear.exists(kit):
		merc["equipment"]["main_hand"] = make_item(kit, "common")
	merc["health"] = 100
	merc["xp"] = 0
	merc["contract"] = "Balanced"
	merc["mission_id"] = ""
	merc["hired_at"] = GameClock.now()
	merc["idle_t"] = GameClock.now()
	var bought: bool = str(merc.get("kind", "")) == "contract"
	if bought:
		merc["settle_until"] = GameClock.now() + Mercs.SETTLE_SECONDS
	for key in ["kit", "kind", "price"]:
		merc.erase(key)
	gold -= int(candidate["hire"])
	crew.append(merc)
	save_game()
	if bought:
		return "%s's contract is yours, bought from %s." % [str(merc["name"]), str(merc.get("from", "another guild"))]
	return "%s has joined the guild." % str(merc["name"])

## What an NPC guild pays for a mercenary's contract today: half their shown value.
func contract_offer(merc: Dictionary) -> int:
	return int(round(float(Mercs.value(merc)) * Mercs.NPC_BUY))

## Seconds before a transferred mercenary can be sold again (0 when free to sell).
func settling_left(merc: Dictionary) -> int:
	return maxi(0, int(merc.get("settle_until", 0)) - GameClock.now())

## Sell a mercenary's contract (with the gear they wear) to another guild. Mercenaries talk:
## every sale costs a little reputation.
func sell_contract(id: String) -> String:
	var merc := merc_by_id(id)
	if merc.is_empty():
		return "Hellfarer not found."
	if not is_available(merc):
		return "%s is out." % str(merc["name"])
	if settling_left(merc) > 0:
		return "%s is still settling in and can't be sold yet." % str(merc["name"])
	var offer: int = contract_offer(merc)
	var loss: int = maxi(Mercs.SALE_REP_MIN, int(float(reputation) * Mercs.SALE_REP_LOSS))
	reputation = maxi(0, reputation - loss)
	gold += offer
	crew.erase(merc)
	retired_ids.append(id)
	_apply_relief_payment()
	save_game()
	return "Sold %s's contract for %d G. Word gets around: reputation -%d." % [str(merc["name"]), offer, loss]

## Reputation comes from what a company delivers (merchant value of the haul); a crew that
## never comes back costs a little.
func _earn_reputation(value: int, wiped_out: bool = false) -> void:
	reputation += maxi(0, int(round(float(value) * Mercs.REP_PER_GOLD)))
	if wiped_out:
		reputation = maxi(0, reputation - maxi(3, int(float(reputation) * 0.01)))

func terms(merc: Dictionary) -> Dictionary:
	var wage: int = int(merc.get("wage", 10))
	if Mercs.has_trait(merc, "frugal"):
		wage = maxi(1, int(round(float(wage) * 0.8)))
	var cut: float = float(merc.get("share", 0.10)) + (0.05 if Mercs.has_trait(merc, "greedy") else 0.0)
	match str(merc.get("contract", "Balanced")):
		"Guaranteed Wage":
			wage = int(ceil(float(wage) * 1.8))
			cut = maxf(0.01, cut - 0.06)
		"Profit Share":
			wage = maxi(1, int(round(float(wage) * 0.45)))
			cut += 0.07
	return {"wage": wage, "cut": cut}

func switch_contract(id: String) -> String:
	var merc := merc_by_id(id)
	if merc.is_empty():
		return "Hellfarer not found."
	if not is_available(merc):
		return "Contracts cannot change mid-expedition."
	var idx: int = CONTRACTS.find(str(merc.get("contract", "Balanced")))
	merc["contract"] = CONTRACTS[(idx + 1) % CONTRACTS.size()]
	save_game()
	return "%s now works under %s terms." % [str(merc["name"]), str(merc["contract"])]

func gear_cost(gear_level: int) -> Dictionary:
	match gear_level:
		0: return {"gold": 85, "iron": 8}
		1: return {"gold": 240, "iron": 18, "silver": 3}
		2: return {"gold": 680, "silver": 12, "crystal": 6}
		3: return {"gold": 2200, "crystal": 24, "relic": 2, "sovereign": 1}
	return {}

func cost_text(cost: Dictionary) -> String:
	var parts: Array[String] = []
	for key in cost:
		var name: String = "Gold" if key == "gold" else str(RESOURCE_NAMES.get(key, key))
		parts.append("%d %s" % [int(cost[key]), name])
	return ", ".join(parts)

func _can_afford(cost: Dictionary) -> bool:
	for item in cost:
		var owned: int = gold if item == "gold" else int(resources.get(item, 0))
		if owned < int(cost[item]):
			return false
	return true

func _pay(cost: Dictionary) -> void:
	for item in cost:
		if item == "gold":
			gold -= int(cost[item])
		else:
			resources[item] = int(resources.get(item, 0)) - int(cost[item])

func improve_gear(id: String) -> String:
	var merc := merc_by_id(id)
	if merc.is_empty():
		return "Hellfarer not found."
	if not is_available(merc):
		return "Cannot refit a Hellfarer who is below."
	var level: int = int(merc.get("gear", 0))
	if level >= 4:
		return "This Hellfarer has the finest equipment available."
	var cost := gear_cost(level)
	if not _can_afford(cost):
		return "Upgrade needs: " + cost_text(cost)
	_pay(cost)
	merc["gear"] = level + 1
	save_game()
	return "%s now has equipment tier %d." % [str(merc["name"]), level + 1]

## Mercenaries resting in town recover REST_PER_HOUR health an hour for free; treatment
## heals them at once for TREAT_PER_POINT gold per missing point (TREAT_MIN at least).
const REST_PER_HOUR := 20
## Heroes are tended between crypt runs: they recover this many times faster.
const HERO_REST_MULT := 6.0
const TREAT_PER_POINT := 0.6
const TREAT_MIN := 5

static func treat_cost(merc: Dictionary) -> int:
	var missing: int = 100 - int(merc.get("health", 100))
	return 0 if missing <= 0 else maxi(TREAT_MIN, int(ceil(float(missing) * TREAT_PER_POINT)))

## Seconds until a resting mercenary is back to full health (0 if healthy).
static func rest_eta(merc: Dictionary) -> int:
	var missing: int = 100 - int(merc.get("health", 100))
	return 0 if missing <= 0 else int(ceil(float(missing) * 3600.0 / (float(REST_PER_HOUR) * Mercs.rest_mult(merc))))

## Resting: idle mercenaries heal over time, including while the game is closed.
func rest(now: int = -1) -> void:
	if now < 0:
		now = GameClock.now()
	for merc in crew + heroes:
		var per_point: float = 3600.0 / (float(REST_PER_HOUR) * Mercs.rest_mult(merc) * (HERO_REST_MULT if Heroes.is_hero(merc) else 1.0))
		if not is_available(merc) or int(merc.get("health", 100)) >= 100:
			merc.erase("rest_t")
			continue
		if not merc.has("rest_t"):
			merc["rest_t"] = now
			continue
		var gain: int = int(float(now - int(merc["rest_t"])) / per_point)
		if gain <= 0:
			continue
		merc["health"] = mini(100, int(merc.get("health", 100)) + gain)
		if int(merc["health"]) >= 100:
			merc.erase("rest_t")
		else:
			merc["rest_t"] = int(merc["rest_t"]) + int(float(gain) * per_point)

## Idle mercenaries still draw half their trip wage each day (paid as time passes, including
## while the game is closed), so holding mercenaries as an investment costs something.
const IDLE_WAGE_SHARE := 0.5

## Gold a mercenary costs per day while idle in town.
func idle_upkeep(merc: Dictionary) -> float:
	return float(terms(merc)["wage"]) * IDLE_WAGE_SHARE

## Upkeep for the whole crew per day if nobody worked.
func idle_upkeep_total() -> int:
	var total: float = 0.0
	for merc in crew:
		total += idle_upkeep(merc)
	return int(round(total))

## Charge idle upkeep up to `now`. Whole gold only; the rest carries over. A company with no
## gold left isn't charged (its mercenaries go unpaid rather than into debt).
func upkeep(now: int = -1) -> int:
	if now < 0:
		now = GameClock.now()
	var paid: int = 0
	for merc in crew:
		if not is_available(merc):
			merc.erase("idle_t")
			continue
		if not merc.has("idle_t"):
			merc["idle_t"] = now
			continue
		var per_day: float = idle_upkeep(merc)
		if per_day <= 0.0:
			merc["idle_t"] = now
			continue
		var owed: int = int(float(now - int(merc["idle_t"])) * per_day / 86400.0)
		if owed <= 0:
			continue
		var charge: int = mini(owed, maxi(0, gold))
		gold -= charge
		paid += charge
		merc["idle_t"] = int(merc["idle_t"]) + int(ceil(float(owed) * 86400.0 / per_day))
	return paid

func treat(id: String) -> String:
	var merc := merc_by_id(id)
	if merc.is_empty():
		return "Hellfarer not found."
	if not is_available(merc):
		return "That Hellfarer is still below."
	if int(merc.get("health", 100)) >= 100:
		return "No treatment required."
	var cost: int = treat_cost(merc)
	if gold < cost:
		return "Treatment requires %d gold." % cost
	gold -= cost
	merc["health"] = 100
	merc.erase("rest_t")
	save_game()
	return "%s recovered for %d gold." % [str(merc["name"]), cost]

## Expedition charters are the only way to field more crews (see data/catalog.json, upgrades):
## charter_N opens slot N+1, for gold plus materials and, from the third crew, a reputation tier.
const MAX_SLOTS := 5

## The next charter to build, or "" when every slot is open.
func next_charter() -> String:
	return "charter_%d" % expedition_slots if expedition_slots < MAX_SLOTS else ""

## Why the next charter can't be built yet ("" when it can).
func charter_block() -> String:
	var id: String = next_charter()
	if id == "":
		return "Every expedition slot is open."
	var c: Dictionary = Catalog.data()["upgrades"][id]
	if reputation < int(c.get("rep", 0)):
		return "Needs %s reputation (%s)." % [Mercs.tier_name(Mercs.tier_for(int(c["rep"]))), str(int(c["rep"]))]
	if gold < upgrade_gold(id):
		return "Needs %d gold, counting materials bought from the merchants." % upgrade_gold(id)
	return ""

## Old name for the next charter's price (0 when every slot is open).
func expansion_cost() -> int:
	return upgrade_gold(next_charter()) if next_charter() != "" else 0

func expand_operations() -> String:
	if next_charter() == "":
		return "Maximum expedition capacity reached."
	return build_upgrade(next_charter())

# --- Heroes (rules in heroes.gd) ---------------------------------------------------------

## Crews out on trade work (expedition slots). Hero crypt runs don't count.
func crews_out() -> int:
	var n: int = 0
	for m in missions:
		if not bool(m.get("heroes", false)):
			n += 1
	return n

## Hero crypt runs under way.
func hero_runs_out() -> int:
	var n: int = 0
	for m in missions:
		if bool(m.get("heroes", false)):
			n += 1
	return n

func free_heroes() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for h in heroes:
		if is_available(h):
			out.append(h)
	return out

## What the next hero slot costs (0 when every slot is open).
func hero_slot_price() -> int:
	if hero_slots >= Heroes.MAX_SLOTS:
		return 0
	return int(Heroes.SLOT_COSTS[hero_slots])

func buy_hero_slot() -> String:
	var price: int = hero_slot_price()
	if price <= 0:
		return "Every hero slot is open."
	if gold < price:
		return "A hero slot costs %d gold." % price
	gold -= price
	hero_slots += 1
	save_game()
	return "A new hero slot: the guild can keep %d heroes." % hero_slots

## Heroes for hire now: one of each class, new faces every half hour.
func hero_board() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var epoch: int = int(GameClock.now() / 1800.0)
	for i in range(Heroes.CLASS_ORDER.size()):
		var c: String = str(Heroes.CLASS_ORDER[i])
		var rng := RandomNumberGenerator.new()
		rng.seed = epoch * 31 + i * 7 + 5
		var id: String = "herocand_%d_%d" % [epoch, i]
		if retired_ids.has(id) or not merc_by_id(id).is_empty():
			continue
		var h: Dictionary = Heroes.make(id, Names.pick(rng), c)
		h["hire"] = Heroes.HIRE_COST
		out.append(h)
	return out

## Take on a hero from the board (needs a free hero slot).
func hire_hero(id: String) -> String:
	if heroes.size() >= hero_slots:
		return "Every hero slot is taken. Buy another slot first."
	for cand in hero_board():
		if str(cand["id"]) != id:
			continue
		if gold < int(cand["hire"]):
			return "Hiring %s costs %d gold." % [str(cand["name"]), int(cand["hire"])]
		gold -= int(cand["hire"])
		return _add_hero(cand)
	return "That hero isn't for hire any more."

## The guild's first hero after the fall: chosen by class, free, with a starter weapon.
func found_hero(hero_class: String, hero_name: String = "") -> String:
	if not heroes.is_empty():
		return "The guild already has a hero."
	var rng := RandomNumberGenerator.new()
	rng.seed = GameClock.now()
	var h: Dictionary = Heroes.make("hero_%d" % next_hero_id, hero_name if hero_name != "" else Names.pick(rng), hero_class)
	return _add_hero(h)

func _add_hero(cand: Dictionary) -> String:
	var h: Dictionary = cand.duplicate(true)
	h.erase("hire")
	if not str(h["id"]).begins_with("hero_"):
		h["id"] = "hero_%d" % next_hero_id
	next_hero_id += 1
	var starter: String = str(Heroes.STARTER.get(Heroes.cls(h), ""))
	if Gear.exists(starter) and (Gear.in_slot(h, "main_hand") as Dictionary).is_empty():
		h["equipment"]["main_hand"] = make_item(starter, "common")
	h["mission_id"] = ""
	h["hired_at"] = GameClock.now()
	heroes.append(h)
	save_game()
	return "%s the %s joins the guild." % [str(h["name"]), Heroes.class_name_of(h)]

## Guilds from before heroes: their best-armed fighter becomes their first hero (a dagger makes
## a rogue, anything else a knight), and weapons and armour on everyone else go to the
## warehouse. Mercenaries in a crypt run keep theirs until they're back.
func _migrate_to_heroes() -> void:
	var best: Dictionary = {}
	var best_score: int = -1
	for merc in crew:
		if not is_available(merc) or Gear.job(merc) != "combat":
			continue
		var score: int = Gear.kit_rating(merc) * 10 + TradeSkills.level_of(merc, "combat")
		if score > best_score:
			best_score = score
			best = merc
	if not best.is_empty():
		var weapon: String = str(Gear.in_slot(best, "main_hand").get("key", ""))
		crew.erase(best)
		best["hero"] = true
		best["class"] = "rogue" if weapon.ends_with("_dagger") else "knight"
		best["wage"] = Heroes.wage(best)
		best["share"] = 0.0
		var old_id: String = str(best["id"])
		best["id"] = "hero_%d" % next_hero_id
		next_hero_id += 1
		retired_ids.append(old_id)
		heroes.append(best)
	for merc in crew:
		if str(merc.get("mission_id", "")) != "" and _in_crypt(str(merc["mission_id"])):
			continue
		var worn: Dictionary = merc.get("equipment", {})
		for slot in worn.keys():
			var item: Dictionary = worn[slot]
			if item.is_empty() or not Heroes.hero_only(str(item.get("key", ""))):
				continue
			equipment_inventory.append(item)
			worn[slot] = {}

func _in_crypt(mission_id: String) -> bool:
	for m in missions:
		if str(m.get("id", "")) == mission_id:
			return str(m.get("region", "")) == "dungeon"
	return false

func merc_power(merc: Dictionary, region: Dictionary) -> int:
	var power: int = int(merc.get("skill", 10)) + int(merc.get("gear", 0)) * 8
	power += int(merc.get("xp", 0)) / 3
	if Mercs.role_of(merc) == str(region.get("focus", "")):
		power += 7
	power = int(round(float(power) * (0.5 + float(merc.get("health", 100)) / 200.0)))
	return power

func success_chance(region: Dictionary, ids: Array[String], tactic: String) -> float:
	var power: int = 0
	for id in ids:
		var merc := merc_by_id(id)
		if not merc.is_empty():
			power += merc_power(merc, region)
	var probability: float = 0.60 + float(power - int(region.get("threat", 20))) * 0.013
	if tactic == "Cautious":
		probability += 0.12
	elif tactic == "Deep Push":
		probability -= 0.17
	return clampf(probability, 0.10, 0.96)

func expedition_cost(region: Dictionary, ids: Array[String]) -> int:
	var cost: int = int(region.get("supplies", 0))
	for id in ids:
		var merc := merc_by_id(id)
		if not merc.is_empty():
			cost += int(terms(merc)["wage"])
	return cost

func expedition_seconds(region: Dictionary, tactic: String) -> int:
	var mult: float = 1.15 if tactic == "Cautious" else (0.85 if tactic == "Deep Push" else 1.0)
	return maxi(15, int(round(float(region["time"]) * mult)))

func dispatch(region_id: String, ids: Array[String], tactic: String) -> String:
	var region := region_by_id(region_id)
	if region.is_empty():
		return "Unknown expedition."
	if reputation < int(region["rep"]):
		return "This region requires %d reputation." % int(region["rep"])
	if crews_out() >= expedition_slots:
		return "All expedition slots are occupied."
	if ids.is_empty() or ids.size() > 3:
		return "Choose one to three available Hellfarers."
	var seen: Dictionary = {}
	for id in ids:
		var merc := merc_by_id(id)
		if merc.is_empty() or not is_available(merc) or seen.has(id):
			return "The crew includes an unavailable Hellfarer."
		if int(merc.get("health", 100)) < 25:
			return "%s needs medical treatment before traveling." % str(merc["name"])
		seen[id] = true
	if not TACTICS.has(tactic):
		return "Invalid expedition strategy."
	var cost: int = expedition_cost(region, ids)
	if gold < cost:
		return "Requires %d gold upfront for wages and supplies." % cost
	gold -= cost
	var now: int = GameClock.now()
	var mission_id := "job_%d" % next_mission_id
	next_mission_id += 1
	var party_cut: float = 0.0
	for id in ids:
		var merc := merc_by_id(id)
		merc["mission_id"] = mission_id
		party_cut += float(terms(merc)["cut"])
	var mission: Dictionary = {
		"id": mission_id, "region": region_id, "ids": ids.duplicate(), "tactic": tactic,
		"started": now, "finish": now + expedition_seconds(region, tactic),
		"seed": randi(), "cost": cost, "chance": success_chance(region, ids, tactic),
		"share": minf(party_cut, 0.85)
	}
	missions.append(mission)
	save_game()
	return "Expedition funded! %d gold spent; your crew is in the field." % cost

func complete_due(now: int = -1) -> int:
	if now < 0:
		now = GameClock.now()
	var completed: int = 0
	var delving: bool = _dungeon_tick(now)
	if _ah_tick(now):
		delving = true
	for i in range(missions.size() - 1, -1, -1):
		var mission: Dictionary = missions[i]
		if int(mission["finish"]) > now:
			continue
		if str(mission.get("region", "")) == "dungeon" and str(mission.get("stage", "out")) != "out":
			continue
		# Returning crews start resting from the moment they got home, not from now.
		for id in mission.get("ids", []):
			var back: Dictionary = merc_by_id(str(id))
			if not back.is_empty():
				back["rest_t"] = int(mission["finish"])
				back["idle_t"] = int(mission["finish"])
		if str(mission.get("region", "")) == "dungeon":
			_dungeon_finish(mission)
		elif mission.has("site"):
			_site_finish(mission)
		elif str(mission.get("region", "")) == "harlow":
			_harlow_finish(mission)
		elif str(mission.get("region", "")) == "guild_work":
			_finish_guild_work(mission)
		else:
			_finish(mission)
		missions.remove_at(i)
		completed += 1
	rest(now)
	if upkeep(now) > 0 and completed == 0:
		save_game()
	if completed > 0 or delving:
		save_game()
	return completed

# Guild-supported recovery work: pays modest guaranteed fees, never kills workers,
# requires no capital, and uses the ordinary expedition timer/save system.
# A clerk can always do basic paperwork even after every mercenary is gone.
const GUILD_WORK_SECONDS := 150
const OFFICE_WORK_SECONDS := 180
const GUILD_WORK_PAY := 18
const OFFICE_WORK_PAY := 9

func available_guild_workers() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for merc in crew:
		if is_available(merc):
			result.append(merc)
	return result

func can_accept_guild_work() -> bool:
	# These are loss-recovery assignments, not an unlimited safer alternative
	# to dangerous expeditions or the eventual player economy. Judged on what the
	# company could actually raise (see liquid_worth), so gear worn by the crew
	# never locks a broke company out of help.
	return gold < 120 and liquid_worth() < 250

func start_guild_work(worker_id: String = "") -> String:
	if not can_accept_guild_work():
		return "Warden work is only for guilds below 120 G cash and 250 G total net worth."
	if crews_out() >= expedition_slots:
		return "All operation slots are occupied."
	var worker: Dictionary = {}
	if not worker_id.is_empty():
		worker = merc_by_id(worker_id)
		if worker.is_empty() or not is_available(worker):
			return "This contractor cannot accept a guild work order."
	var office: bool = worker_id.is_empty()
	var now: int = GameClock.now()
	var task_id: String = "job_%d" % next_mission_id
	next_mission_id += 1
	if not office:
		worker["mission_id"] = task_id
	missions.append({
		"id": task_id, "region": "guild_work", "ids": [] if office else [worker_id],
		"worker": worker_id, "office": office, "cost": 0,
		"cash": OFFICE_WORK_PAY if office else GUILD_WORK_PAY,
		"started": now, "finish": now + (OFFICE_WORK_SECONDS if office else GUILD_WORK_SECONDS)
	})
	save_game()
	if office:
		return "Guild paperwork accepted: 9 G after 3 minutes. No danger or fees."
	return "%s assigned a safe guild work order: 18 G after 2m 30s." % str(worker["name"])

func _finish_guild_work(mission: Dictionary) -> void:
	var worker_id: String = str(mission.get("worker", ""))
	var worker_name: String = "The guild office"
	if not worker_id.is_empty():
		var worker: Dictionary = merc_by_id(worker_id)
		if not worker.is_empty():
			worker_name = str(worker.get("name", "Contractor"))
			worker["mission_id"] = ""
			worker["xp"] = int(worker.get("xp", 0)) + 1
	var payout: int = int(mission.get("cash", OFFICE_WORK_PAY))
	gold += payout
	# Debt repayment only touches funds above the existing 120 G safety reserve.
	_apply_relief_payment()
	reports.push_front({
		"region": "Warden Work", "won": true, "loot": {},
		"cash": payout, "commission": 0, "cost": 0, "gross": payout,
		"time": int(mission["finish"]), "tactic": "Safe Work",
		"crew": mission.get("ids", []), "events": [
			"%s completed routine contract work for the guild." % worker_name,
			"Guaranteed fee: %d gold. No combat, injuries or equipment exposure." % payout
		], "casualties": [], "injured": [], "lost_items": [], "found_items": []
	})
	if reports.size() > 35:
		reports.resize(35)

func _finish(mission: Dictionary) -> void:
	var region := region_by_id(str(mission["region"]))
	if region.is_empty():
		return
	var rng := RandomNumberGenerator.new()
	rng.seed = int(mission["seed"])
	var succeeded: bool = rng.randf() <= float(mission["chance"])
	var mult: float = 0.75 if str(mission["tactic"]) == "Cautious" else (1.45 if str(mission["tactic"]) == "Deep Push" else 1.0)
	if not succeeded:
		mult *= 0.25
	var loot: Dictionary = {}
	for item in region["loot"]:
		var limits: Array = region["loot"][item]
		var count: int = int(round(float(rng.randi_range(int(limits[0]), int(limits[1]))) * mult))
		if count > 0:
			loot[item] = count
	if succeeded and rng.randf() <= float(region["bonus_odds"]) * (1.5 if str(mission["tactic"]) == "Deep Push" else 1.0):
		var bonus: String = str(region["bonus"])
		loot[bonus] = int(loot.get(bonus, 0)) + 1
	if succeeded and rng.randf() < float(region["relic_odds"]) * mult:
		loot["relic"] = int(loot.get("relic", 0)) + 1
	if succeeded and rng.randf() < float(region["sovereign_odds"]) * mult:
		loot["sovereign"] = int(loot.get("sovereign", 0)) + 1
	var cash_found: int = rng.randi_range(10, 24) if succeeded else rng.randi_range(0, 5)
	cash_found = int(round(float(cash_found) * mult))
	var gross_value: int = cash_found
	for item in loot:
		resources[item] = int(resources.get(item, 0)) + int(loot[item])
		gross_value += int(loot[item]) * price(item)
	var commission: int = int(ceil(float(gross_value) * float(mission["share"])))
	gold += cash_found - commission
	for id in mission["ids"]:
		var merc := merc_by_id(str(id))
		if merc.is_empty():
			continue
		merc["mission_id"] = ""
		merc["xp"] = int(merc.get("xp", 0)) + (1 if succeeded else 0)
		if not succeeded:
			merc["health"] = maxi(20, int(merc.get("health", 100)) - rng.randi_range(12, 32))
	_earn_reputation(gross_value)
	var result: Dictionary = {
		"region": str(region["name"]), "won": succeeded, "loot": loot, "cash": cash_found,
		"commission": commission, "cost": int(mission["cost"]), "gross": gross_value,
		"time": int(mission["finish"]), "tactic": str(mission["tactic"]), "crew": mission["ids"]
	}
	reports.push_front(result)
	if reports.size() > 35:
		reports.resize(35)

## Fair reference value of a good today (see MarketModel).
func price(item: String) -> int:
	return market.reference_price(item)

## Merchants sell raw goods and plain crafting materials (ingots, linen, flour), not food
## or potions: those come from cooks and brewers.
func merchants_sell(item: String) -> bool:
	return item != "relic" and item != "sovereign" and str(RESOURCE_KIND.get(item, "raw")) != "food" and not Catalog.item(item).get("category", "") == "potion"

## What an NPC merchant pays per unit when the company sells `quantity`.
func sell_price(item: String, quantity: int = 1) -> int:
	return market.npc_buy_price(item, quantity)

## What an NPC merchant charges per unit when the company buys `quantity`.
func buy_price(item: String, quantity: int = 1) -> int:
	return market.npc_sell_price(item, quantity)

## Record hourly price samples; called from the game clock.
func market_tick() -> void:
	market.sample_all(RESOURCE_ORDER)

func trade(item: String, buy: bool, quantity: int) -> String:
	if not BASE_PRICE.has(item) or quantity <= 0:
		return "Invalid trade."
	if buy:
		if item == "relic" or item == "sovereign":
			return "Saint's Relics and Ashen Crown Shards cannot be bought from merchants."
		if not merchants_sell(item):
			return "Merchants don't stock %s. Cook or brew it, or buy from other players." % str(RESOURCE_NAMES[item])
		var cost: int = buy_price(item, quantity) * quantity
		if gold < cost:
			return "You need %d gold for this purchase." % cost
		gold -= cost
		resources[item] = int(resources.get(item, 0)) + quantity
		market.record_npc_trade(item, -quantity)
		save_game()
		return "Purchased %d %s for %d gold." % [quantity, str(RESOURCE_NAMES[item]), cost]
	if int(resources.get(item, 0)) < quantity:
		return "You don't have that many resources."
	var revenue: int = sell_price(item, quantity) * quantity
	resources[item] = int(resources[item]) - quantity
	gold += revenue
	market.record_npc_trade(item, quantity)
	_apply_relief_payment()
	save_game()
	return "Sold %d %s for %d gold." % [quantity, str(RESOURCE_NAMES[item]), revenue]

# --- Trade Hall -----------------------------------------------------------------

## Display name for an item ref: a good key, or "gear:<item key>".
func item_ref_name(ref: String) -> String:
	if ref.begins_with("gear:"):
		return str(item_definition(ref.substr(5)).get("name", "Gear"))
	return str(RESOURCE_NAMES.get(ref, ref.capitalize()))

## Spare gear in the storeroom, uid -> item key.
func storeroom_keys() -> Dictionary:
	var keys: Dictionary = {}
	for item in equipment_inventory:
		keys[str(item.get("uid", ""))] = str(item.get("key", ""))
	return keys

func hall_say(text: String, links: Array, now: int = -1) -> String:
	return hall.say(text, links, now if now >= 0 else GameClock.now())

## Send a trader a trade request (they accept once a price is agreed).
func hall_request_trade(trader: String, now: int = -1) -> String:
	return hall.request_trade(trader, now if now >= 0 else GameClock.now())

## Block or unblock a trader; the list is saved.
func hall_block(trader: String, on: bool = true) -> void:
	if on:
		hall.block(trader)
	else:
		hall.unblock(trader)
	save_game()

func hall_pm(trader: String, text: String, links: Array, now: int = -1) -> String:
	return hall.pm(trader, text, links, now if now >= 0 else GameClock.now())

## Advance the Hall. Trades complete here once both sides are ready.
func hall_tick(now: int = -1) -> Array:
	var t: int = now if now >= 0 else GameClock.now()
	var events: Array = hall.tick(t)
	if hall.session != null and hall.session.is_open() and hall.session.both_accepted():
		var trader: String = hall.session.trader
		var result: String = trade_complete(t)
		events.append({"type": "trade_done" if result.begins_with("Traded") else "trade_failed", "trader": trader, "message": result})
	return events

## Put goods from the warehouse into the company's side of the trade (sets the amount).
## Your side can only change while it is unlocked.
func trade_editable() -> bool:
	return hall.session != null and hall.session.is_open() and not hall.session.my_locked

func trade_set_goods(good: String, quantity: int, now: int = -1) -> void:
	var s: TradeSession = hall.session
	if not trade_editable() or not BASE_PRICE.has(good):
		return
	var amount: int = clampi(quantity, 0, int(resources.get(good, 0)))
	if amount <= 0:
		s.mine_goods.erase(good)
	else:
		s.mine_goods[good] = amount
	hall.trade_changed(storeroom_keys(), now if now >= 0 else GameClock.now())

func trade_toggle_gear(uid: String, now: int = -1) -> void:
	var s: TradeSession = hall.session
	if not trade_editable() or not storeroom_keys().has(uid):
		return
	if s.mine_gear.has(uid):
		s.mine_gear.erase(uid)
	else:
		s.mine_gear.append(uid)
	hall.trade_changed(storeroom_keys(), now if now >= 0 else GameClock.now())

func trade_set_gold(amount: int, now: int = -1) -> void:
	var s: TradeSession = hall.session
	if not trade_editable():
		return
	s.mine_gold = clampi(amount, 0, maxi(0, gold))
	hall.trade_changed(storeroom_keys(), now if now >= 0 else GameClock.now())

## Step 1: lock the company's side. If it falls short of the deal, the trader says so.
func trade_lock(now: int = -1) -> void:
	hall.trade_lock(storeroom_keys(), now if now >= 0 else GameClock.now())

## Unlocking (to change something) clears both sides' locks.
func trade_unlock(now: int = -1) -> void:
	hall.trade_changed(storeroom_keys(), now if now >= 0 else GameClock.now())

## Step 2: accept, once both sides are locked and the pause has passed.
func trade_accept(now: int = -1) -> bool:
	return hall.trade_accept(now if now >= 0 else GameClock.now())

func trade_cancel(now: int = -1) -> void:
	hall.trade_cancel(now if now >= 0 else GameClock.now())

## Swap both sides. Gold the company receives is taxed 3%.
func trade_complete(now: int = -1) -> String:
	var s: TradeSession = hall.session
	if s == null or not s.is_open():
		return "No trade is open."
	var t: int = now if now >= 0 else GameClock.now()
	var keys: Dictionary = storeroom_keys()
	for good in s.mine_goods:
		if int(resources.get(good, 0)) < int(s.mine_goods[good]):
			s.changed()
			return "You no longer have that many %s." % item_ref_name(str(good))
	for uid in s.mine_gear:
		if not keys.has(uid):
			s.changed()
			return "That gear is no longer in the Warehouse."
	if gold < s.mine_gold:
		s.changed()
		return "You don't have %d gold." % s.mine_gold
	# The company's side leaves.
	gold -= s.mine_gold
	for good in s.mine_goods:
		resources[good] = int(resources[good]) - int(s.mine_goods[good])
		market.record_npc_trade(str(good), int(s.mine_goods[good]), t)
	for uid in s.mine_gear:
		for i in range(equipment_inventory.size()):
			if str(equipment_inventory[i].get("uid", "")) == uid:
				equipment_inventory.remove_at(i)
				break
	# The trader's side arrives.
	var tax: int = int(round(float(s.their_gold) * TradeHall.TAX)) if s.their_gold > 0 else 0
	gold += s.their_gold - tax
	for good in s.their_goods:
		resources[good] = int(resources.get(good, 0)) + int(s.their_goods[good])
		market.record_npc_trade(str(good), -int(s.their_goods[good]), t)
	for key in s.their_gear:
		equipment_inventory.append(make_item(str(key)))
	var trader: String = s.trader
	var got: Array[String] = []
	for good in s.their_goods:
		got.append("%d %s" % [int(s.their_goods[good]), item_ref_name(str(good))])
	for key in s.their_gear:
		got.append(item_ref_name("gear:" + str(key)))
	if s.their_gold > 0:
		got.append("%d gold (%d tax)" % [s.their_gold - tax, tax])
	hall.trade_finished(t)
	_apply_relief_payment()
	save_game()
	return "Traded with %s. Received %s." % [trader, ", ".join(got) if not got.is_empty() else "nothing"]

## A catalog item's definition, with "cost" (its value) for older callers.
func item_definition(key: String) -> Dictionary:
	var d: Dictionary = Catalog.item(key)
	if d.is_empty():
		return {}
	d = d.duplicate()
	d["cost"] = int(d.get("value", 0))
	return d

func owned_equipment_value() -> int:
	var amount: int = 0
	for item in equipment_inventory:
		amount += Gear.value(item)
	for merc in crew + heroes:
		for item in Gear.worn(merc):
			amount += Gear.value(item)
	return amount

## A new piece with its own uid. Rarity is rolled unless given ("common" for shop stock).
func make_item(key: String, rarity: String = "") -> Dictionary:
	var rng := RandomNumberGenerator.new()
	rng.randomize()
	var item: Dictionary = Gear.make(key, "gear_%d" % next_item_id, rng, rarity)
	next_item_id += 1
	return item

## What a piece sells for to the quartermaster: 65% of its worth, less if it's worn down.
func resale_value(item: Dictionary) -> int:
	var top: int = Gear.max_durability(item)
	var condition: float = 1.0 if top <= 0 else 0.5 + 0.5 * float(Gear.durability(item)) / float(top)
	return maxi(1, int(floor(float(Gear.value(item)) * 0.65 * condition)))

func buy_equipment(key: String) -> String:
	var definition: Dictionary = item_definition(key)
	if definition.is_empty():
		return "That equipment does not exist."
	if bool(definition.get("found_only", false)):
		return "That piece can't be bought. It's only found on the dead below."
	if not V05.SHOP.has(key):
		return "The quartermaster doesn't stock that. It has to be crafted."
	var cost: int = int(definition["cost"])
	if gold < cost:
		return "You need %d gold." % cost
	gold -= cost
	equipment_inventory.append(make_item(key, "common"))
	save_game()
	return "Purchased %s for %d gold." % [str(definition["name"]), cost]

func sell_equipment(uid: String) -> String:
	for i in range(equipment_inventory.size()):
		var item: Dictionary = equipment_inventory[i]
		if str(item.get("uid", "")) != uid:
			continue
		var value: int = resale_value(item)
		equipment_inventory.remove_at(i)
		gold += value
		_apply_relief_payment()
		save_game()
		return "Sold %s for %d gold." % [Gear.full_name(item), value]
	return "Only loose equipment in the armory may be sold."

## Put a piece from the storeroom on a mercenary; whatever was in that slot goes back.
## A two-handed weapon also clears the off hand.
func equip_item(merc_id: String, uid: String) -> String:
	var merc: Dictionary = merc_by_id(merc_id)
	if merc.is_empty() or not is_available(merc):
		return "Select an available Hellfarer."
	var index: int = -1
	for i in range(equipment_inventory.size()):
		if str(equipment_inventory[i].get("uid", "")) == uid:
			index = i
			break
	if index < 0:
		return "Equipment not found in the armory."
	var item: Dictionary = equipment_inventory[index]
	var key: String = str(item.get("key", ""))
	if not V05.validate_role(key, merc) or Gear.consumable(key):
		return "That can't be worn."
	if Heroes.hero_only(key) and not Heroes.is_hero(merc):
		return "Only heroes wear weapons and armour. %s can carry tools, a hunting weapon, a trinket or a pack." % str(merc["name"])
	Gear.ensure(merc)
	var slot: String = Gear.slot_of(key)
	var worn: Dictionary = merc["equipment"]
	if slot == "off_hand" and int(Gear.def(str((worn["main_hand"] as Dictionary).get("key", ""))).get("hands", 1)) == 2:
		return "%s's two-handed weapon needs both hands." % str(merc["name"])
	equipment_inventory.remove_at(index)
	var previous: Dictionary = worn.get(slot, {})
	if not previous.is_empty():
		equipment_inventory.append(previous)
	worn[slot] = item
	if int(Gear.def(key).get("hands", 1)) == 2 and not (worn["off_hand"] as Dictionary).is_empty():
		equipment_inventory.append(worn["off_hand"])
		worn["off_hand"] = {}
	save_game()
	return "%s equipped %s." % [str(merc["name"]), Gear.full_name(item)]

## Food and potions come from the warehouse, one at a time.
func equip_supply(merc_id: String, key: String) -> String:
	var merc: Dictionary = merc_by_id(merc_id)
	if merc.is_empty() or not is_available(merc):
		return "Select an available Hellfarer."
	if not Gear.consumable(key) or int(resources.get(key, 0)) <= 0:
		return "None in the warehouse."
	Gear.ensure(merc)
	var slot: String = Gear.slot_of(key)
	var previous: Dictionary = merc["equipment"][slot]
	if not previous.is_empty():
		resources[str(previous["key"])] = int(resources.get(str(previous["key"]), 0)) + 1
	resources[key] = int(resources[key]) - 1
	merc["equipment"][slot] = {"key": key}
	save_game()
	return "%s packed a %s." % [str(merc["name"]), str(Gear.def(key).get("name", key))]

const LEGACY_SLOT_NAMES := {"tool": "main_hand", "armor": "body"}

func unequip_item(merc_id: String, slot: String) -> String:
	var merc: Dictionary = merc_by_id(merc_id)
	if LEGACY_SLOT_NAMES.has(slot):
		slot = str(LEGACY_SLOT_NAMES[slot])
	if merc.is_empty() or not is_available(merc) or not Gear.SLOTS.has(slot):
		return "Worker unavailable for outfitting."
	Gear.ensure(merc)
	var worn: Dictionary = merc["equipment"]
	var item: Dictionary = worn.get(slot, {})
	if item.is_empty():
		return "Nothing equipped in that slot."
	if Gear.CONSUMABLE_SLOTS.has(slot):
		resources[str(item["key"])] = int(resources.get(str(item["key"]), 0)) + 1
	else:
		equipment_inventory.append(item)
	worn[slot] = {}
	save_game()
	return "%s put away %s." % [str(merc["name"]), Gear.full_name(item)]

# --- Crafting -------------------------------------------------------------------------

## Can the company make this? Intermediates and the starter set (the leather armour) are
## known to everyone; everything else needs its blueprint.
func knows(key: String) -> bool:
	var d: Dictionary = Catalog.item(key)
	if d.is_empty() or d.get("recipe") == null:
		return false
	return (d.get("blueprint", []) as Array).has("crafting") or (d.get("blueprint", []) as Array).has("starter") or blueprints.has(key)

## True if everything the recipe needs can be had today: warehouse goods, or things
## craftable from them (some recipes wait on expeditions that aren't open yet).
func makeable(key: String, depth: int = 0) -> bool:
	var recipe: Variant = Catalog.item(key).get("recipe")
	if not (recipe is Dictionary) or depth > 4:
		return false
	for part in recipe:
		if RESOURCE_ORDER.has(part):
			continue
		if not Catalog.items().has(part) or not makeable(str(part), depth + 1):
			return false
	return true

## Blueprints the quartermaster sells (tiers 1 and 2) that the company doesn't have yet.
func blueprint_shop() -> Array:
	var out: Array = []
	for key in Catalog.items():
		var d: Dictionary = Catalog.items()[key]
		if (d.get("blueprint", []) as Array).has("quartermaster") and not blueprints.has(key):
			out.append(key)
	# What can be made today first, then by tier and value.
	out.sort_custom(func(a, b): return (0 if makeable(a) else 1000000) + int(Catalog.item(a)["tier"]) * 100000 + int(Catalog.item(a)["value"]) < (0 if makeable(b) else 1000000) + int(Catalog.item(b)["tier"]) * 100000 + int(Catalog.item(b)["value"]))
	return out

func buy_blueprint(key: String) -> String:
	var d: Dictionary = Catalog.item(key)
	if d.is_empty() or not (d.get("blueprint", []) as Array).has("quartermaster"):
		return "The quartermaster doesn't have that blueprint. Better ones are found in the crypts."
	if blueprints.has(key):
		return "You already have that blueprint."
	var price: int = int(d.get("blueprint_price", 40))
	if gold < price:
		return "The blueprint costs %d gold." % price
	gold -= price
	blueprints.append(key)
	save_game()
	return "Bought the blueprint for %s (%d G)." % [str(d["name"]), price]

## Materials still missing to craft `count` (empty when everything is in the warehouse).
func craft_missing(key: String, count: int = 1) -> Dictionary:
	var missing: Dictionary = {}
	var recipe: Variant = Catalog.item(key).get("recipe")
	if not (recipe is Dictionary):
		return {"blueprint": 1}
	for part in recipe:
		var need: int = int(recipe[part]) * count - int(resources.get(str(part), 0))
		if need > 0:
			missing[part] = need
	return missing

## Make one: the materials are used up. Gear rolls a rarity and goes to the storeroom;
## ingots, draughts and food go to the warehouse.
func craft(key: String) -> String:
	if not knows(key):
		return "You need the blueprint first."
	var missing: Dictionary = craft_missing(key)
	if not missing.is_empty():
		var parts: Array[String] = []
		for m in missing:
			parts.append("%d %s" % [int(missing[m]), item_ref_name(str(m))])
		return "Not enough materials: missing " + ", ".join(parts) + "."
	var recipe: Dictionary = Catalog.item(key)["recipe"]
	for part in recipe:
		resources[part] = int(resources[part]) - int(recipe[part])
	if Gear.equippable(key) and not Gear.consumable(key):
		var item: Dictionary = make_item(key)
		equipment_inventory.append(item)
		save_game()
		var extra: String = Gear.rolls_text(item)
		return "Crafted %s%s." % [Gear.full_name(item), (": " + extra) if extra != "" else ""]
	resources[key] = int(resources.get(key, 0)) + 1
	save_game()
	return "Crafted %s." % str(Catalog.item(key)["name"])

# --- Company buildings ------------------------------------------------------------------

func has_upgrade(id: String) -> bool:
	return id == "" or upgrades.has(id)

## Buildings that open an expedition (the farm buildings), not yet built.
func upgrade_shop() -> Array:
	var out: Array = []
	var all: Dictionary = Catalog.data().get("upgrades", {})
	for id in all:
		if not upgrades.has(id) and not (all[id].get("unlocks", []) as Array).is_empty():
			out.append(id)
	return out

## Gold a building would take: its own gold price plus missing materials at merchant prices.
func upgrade_gold(id: String) -> int:
	var u: Dictionary = Catalog.data()["upgrades"][id]
	return int(u.get("gold", 0)) + repair_gold(u["cost"])

## Build: materials come from the warehouse; anything missing is bought from the merchants.
func build_upgrade(id: String) -> String:
	var all: Dictionary = Catalog.data().get("upgrades", {})
	if not all.has(id):
		return "No such building."
	if upgrades.has(id):
		return "Already built."
	var charter: bool = id.begins_with("charter_")
	if charter:
		if id != next_charter():
			return "Charters are signed in order; the next is %s." % str(all.get(next_charter(), {}).get("name", "none"))
		if reputation < int(all[id].get("rep", 0)):
			return charter_block()
	var cost: Dictionary = all[id]["cost"]
	for part in cost:
		if int(resources.get(str(part), 0)) < int(cost[part]) and not merchants_sell(str(part)):
			return "You need %d %s; merchants don't sell it." % [int(cost[part]), str(RESOURCE_NAMES.get(part, part))]
	var spend: int = upgrade_gold(id)
	if gold < spend:
		return "That needs %d gold, counting materials bought from the merchants." % spend
	for part in cost:
		var short: int = int(cost[part]) - int(resources.get(str(part), 0))
		if short > 0:
			market.record_npc_trade(str(part), -short)
			resources[part] = int(resources.get(str(part), 0)) + short
		resources[part] = int(resources[part]) - int(cost[part])
	gold -= spend
	upgrades.append(id)
	if charter:
		expedition_slots += 1
	save_game()
	if charter:
		return "%s signed: %d crews can be out at once." % [str(all[id]["name"]), expedition_slots]
	var bought: int = spend - int(all[id].get("gold", 0))
	return "Built the %s%s." % [str(all[id]["name"]), (" (%d G of materials bought)" % bought) if bought > 0 else ""]

# --- Repairs --------------------------------------------------------------------------

## A piece by uid, from the storeroom or worn by a mercenary: [item, owner or {}].
func find_item(uid: String) -> Array:
	for item in equipment_inventory:
		if str(item.get("uid", "")) == uid:
			return [item, {}]
	for merc in crew + heroes:
		for item in Gear.worn(merc):
			if str(item.get("uid", "")) == uid:
				return [item, merc]
	return [{}, {}]

func repair_cost(item: Dictionary) -> Dictionary:
	return Gear.repair_cost(item, RESOURCE_ORDER)

## Gold a repair takes: gold parts plus merchant prices for materials not in the warehouse.
func repair_gold(cost: Dictionary) -> int:
	var total: int = int(cost.get("gold", 0))
	for part in cost:
		if part == "gold":
			continue
		var short: int = int(cost[part]) - int(resources.get(str(part), 0))
		if short > 0:
			total += buy_price(str(part), short) * short
	return total

## Repair a piece to full. Materials come from the warehouse; anything missing is bought from
## the merchants.
func repair(uid: String) -> String:
	var found: Array = find_item(uid)
	var item: Dictionary = found[0]
	var owner: Dictionary = found[1]
	if item.is_empty():
		return "That piece isn't here."
	if not owner.is_empty() and not is_available(owner):
		return "%s is out." % str(owner["name"])
	var cost: Dictionary = repair_cost(item)
	if cost.is_empty():
		return "%s doesn't need repairs." % Gear.full_name(item)
	var spend: int = repair_gold(cost)
	if gold < spend:
		return "Repairs need %d gold for parts and materials." % spend
	for part in cost:
		if part == "gold":
			continue
		var short: int = int(cost[part]) - int(resources.get(str(part), 0))
		if short > 0:
			market.record_npc_trade(str(part), -short)
			resources[part] = int(resources.get(str(part), 0)) + short
		resources[part] = int(resources[part]) - int(cost[part])
	gold -= spend
	item["dur"] = Gear.max_durability(item)
	save_game()
	var parts: Array[String] = []
	for part in cost:
		if part != "gold":
			parts.append("%d %s" % [int(cost[part]), item_ref_name(str(part))])
	if spend > 0:
		parts.append("%d G" % spend)
	return "Repaired %s (%s)." % [Gear.full_name(item), ", ".join(parts)]

## Everything stored or worn by a mercenary in town that needs repairs.
func needs_repair() -> Array:
	var out: Array = []
	for item in equipment_inventory:
		if not repair_cost(item).is_empty():
			out.append(item)
	for merc in crew + heroes:
		if is_available(merc):
			for item in Gear.worn(merc):
				if not repair_cost(item).is_empty():
					out.append(item)
	return out

func guild_relief() -> String:
	if not missions.is_empty() or gold >= 28:
		return "The guild issues advances only when you cannot afford a basic expedition."
	if relief_debt >= 440:
		return "The guild will not extend more credit until you repay some debt."
	if liquid_worth() > 250:
		return "Sell some of your goods or spare gear before requesting guild support."
	gold += 90
	relief_debt += 110
	relief_count += 1
	reputation = maxi(0, reputation - 3)
	save_game()
	return "The guild advanced 90 gold. You owe 110 gold from future trade proceeds."

func _apply_relief_payment() -> void:
	if relief_debt <= 0 or gold <= 120:
		return
	var paid: int = mini(relief_debt, gold - 120)
	gold -= paid
	relief_debt -= paid

## Merchant value of the warehouse.
func goods_value() -> int:
	var total: int = 0
	for item in RESOURCE_ORDER:
		total += int(resources.get(item, 0)) * sell_price(item)
	return total

## What the company could turn into cash today: gold, warehouse goods at merchant
## prices and spare gear in the storeroom, less guild debt. Gear worn by the crew is left
## out, so a company that cannot pay wages always qualifies for guild help.
func liquid_worth() -> int:
	var total: int = gold + goods_value() - relief_debt + auction_value()
	for item in equipment_inventory:
		total += resale_value(item)
	return total

## What's tied up at the Auction House: listed goods and gear at merchant prices, and the
## gold held by buy orders.
func auction_value() -> int:
	var total: int = 0
	for l in auction.listings:
		if l.has("item"):
			total += resale_value(l["item"])
		else:
			total += int(l["left"]) * sell_price(str(l["ref"]), int(l["left"]))
	for o in auction.orders:
		total += (int(o["qty"]) - int(o["got"])) * int(o["price"])
	return total

func wealth() -> int:
	var total: int = gold + goods_value() + auction_value()
	for merc in crew:
		total += int(merc.get("gear", 0)) * 60
	total += owned_equipment_value()
	total -= relief_debt
	return total

func free_crew() -> int:
	var available: int = 0
	for merc in crew:
		if is_available(merc):
			available += 1
	return available

func debug_skip(seconds: int) -> String:
	for mission in missions:
		mission["finish"] = int(mission["finish"]) - seconds
		for k in ["floor_end", "await_until"]:
			if mission.has(k):
				mission[k] = int(mission[k]) - seconds
	var resolved: int = complete_due()
	save_game()
	return "Simulated %d minutes forward; %d expedition(s) completed." % [int(seconds / 60), resolved]

func reset_company() -> void:
	gold = 350
	reputation = 0
	expedition_slots = 1
	next_mission_id = 1
	crew.clear()
	heroes.clear()
	hero_slots = 1
	next_hero_id = 1
	crypt_cleared.clear()
	missions.clear()
	reports.clear()
	harlow.clear()
	equipment_inventory.clear()
	blueprints.clear()
	upgrades.clear()
	next_item_id = 1
	relief_debt = 0
	relief_count = 0
	retired_ids.clear()
	tutorial = {"step": "prologue"}
	market.reset()
	hall.reset()
	fallen = FallenGear.new()
	auction = AuctionHouse.new()
	for item in RESOURCE_ORDER:
		resources[item] = 0
	save_game()


