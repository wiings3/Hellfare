horizontal_alignment = 2

[node name="Value" type="Label" parent="Margin/Content/Report/Body/Top/Net"]
layout_mode = 2
theme_type_variation = &"LabelBig"
text = "+0 G"
horizontal_alignment = 2

[node name="LootCaption" type="Label" parent="Margin/Content/Report/Body"]
layout_mode = 2
