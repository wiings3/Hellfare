[ext_resource type="Texture2D" path="res://assets/ui/kit/sign_check.png" id="3_seal"]

[node name="CompanyRight" type="Control"]
layout_mode = 3
anchors_preset = 0
offset_right = 285.0
offset_bottom = 371.0

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="FieldHeader" parent="Margin/Content" instance=ExtResource("1_header")]
layout_mode = 2
text = "In the Field"

[node name="Expeditions" type="VBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="ReportHeader" parent="Margin/Content" instance=ExtResource("1_header")]
layout_mode = 2
text = "Latest Report"

[node name="Report" type="PanelContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Body" type="VBoxContainer" parent="Margin/Content/Report"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Top" type="HBoxContainer" parent="Margin/Content/Report/Body"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Seal" type="TextureRect" parent="Margin/Content/Report/Body/Top"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
texture = ExtResource("3_seal")
stretch_mode = 3

[node name="Title" type="VBoxContainer" parent="Margin/Content/Report/Body/Top"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = -2

[node name="Place" type="Label" parent="Margin/Content/Report/Body/Top/Title"]
layout_mode = 2
theme_type_variation = &"LabelTitle"
