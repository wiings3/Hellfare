[node name="Outcome" type="Label" parent="Margin/Content/Report/Body/Top/Title"]
layout_mode = 2
theme_type_variation = &"LabelAccent"
text = "Returned safely"

[node name="Net" type="VBoxContainer" parent="Margin/Content/Report/Body/Top"]
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Coin recovered minus wages and provisions."
theme_override_constants/separation = -3

[node name="Caption" type="Label" parent="Margin/Content/Report/Body/Top/Net"]
layout_mode = 2
theme_type_variation = &"LabelCaption"
