[node name="Layer1" type="Label" parent="Margin/Content/Map/Layers"]
theme_type_variation = &"MapLayer"
text = "1"
layout_mode = 0
offset_left = 3.0
offset_top = 59.0
offset_right = 12.0
offset_bottom = 71.0
horizontal_alignment = 1
mouse_filter = 0
tooltip_text = "Layer 1 · The Ashen Verge
Just past the Maw. Dead woods that still burn, old copper workings, and ash falling like snow."

[node name="Layer2" type="Label" parent="Margin/Content/Map/Layers"]
theme_type_variation = &"MapLayer"
text = "2"
layout_mode = 0
offset_left = 16.0
offset_top = 124.0
offset_right = 25.0
offset_bottom = 136.0
horizontal_alignment = 1
mouse_filter = 0
tooltip_text = "Layer 2 · The Weeping Fens
Black water, red marsh, and trees that weep sap like blood. Hounds hunt here."

[node name="Layer3" type="Label" parent="Margin/Content/Map/Layers"]
theme_type_variation = &"MapLayer"
text = "3"
layout_mode = 0
offset_left = 27.0
offset_top = 182.0
offset_right = 36.0
offset_bottom = 194.0
horizontal_alignment = 1
mouse_filter = 0
tooltip_text = "Layer 3 · The Brimstone Reach
Burning slopes, a lake as still as glass, and moors that never stop smouldering."

[node name="Layer4" type="Label" parent="Margin/Content/Map/Layers"]
theme_type_variation = &"MapLayer"
text = "4"
layout_mode = 0
offset_left = 36.0
offset_top = 226.0
offset_right = 45.0
offset_bottom = 238.0
horizontal_alignment = 1
mouse_filter = 0
tooltip_text = "Layer 4 · The Frozen Lament
Ice that holds the screaming, a shore that weeps salt, and pitbears on the ridges."

[node name="Layer5" type="Label" parent="Margin/Content/Map/Layers"]
theme_type_variation = &"MapLayer"
text = "5"
layout_mode = 0
offset_left = 45.0
offset_top = 274.0
offset_right = 54.0
offset_bottom = 286.0
horizontal_alignment = 1
mouse_filter = 0
tooltip_text = "Layer 5 · The Abyss
Black water at the bottom of everything. The Throne Below waits here."

