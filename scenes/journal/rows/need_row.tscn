[gd_scene load_steps=1 format=3]

[node name="NeedRow" type="PanelContainer"]
theme_type_variation = &"InsetPanel"

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="IconSlot" type="PanelContainer" parent="Row"]
layout_mode = 2
custom_minimum_size = Vector2(24, 24)
size_flags_vertical = 4
theme_type_variation = &"SlotPanel"

[node name="Icon" type="TextureRect" parent="Row/IconSlot"]
layout_mode = 2
mouse_filter = 2
stretch_mode = 3

[node name="Info" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = -4

[node name="Name" type="Label" parent="Row/Info"]
layout_mode = 2
text = "Something"
text_overrun_behavior = 3

[node name="Details" type="Label" parent="Row/Info"]
layout_mode = 2
theme_type_variation = &"LabelCaption"
text = "Details"
text_overrun_behavior = 3

[node name="Value" type="Label" parent="Row"]
layout_mode = 2
theme_type_variation = &"LabelGood"
text = ""
visible = false
size_flags_vertical = 4

[node name="Action" type="Button" parent="Row"]
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"PaperButton"
text = "Open"
size_flags_vertical = 4
