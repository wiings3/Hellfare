[gd_scene load_steps=1 format=3]

[node name="ItemCard" type="PanelContainer"]
theme_type_variation = &"InsetPanel"

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="IconSlot" type="PanelContainer" parent="Row"]
layout_mode = 2
custom_minimum_size = Vector2(24, 24)
size_flags_vertical = 4
theme_type_variation = &"SlotPanel"

[node name="Icon" type="TextureRect" parent="Row/IconSlot"]
layout_mode = 2
custom_minimum_size = Vector2(16, 16)
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Info" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = -4

[node name="Name" type="Label" parent="Row/Info"]
layout_mode = 2
text = "Item"
text_overrun_behavior = 3

[node name="Details" type="Label" parent="Row/Info"]
layout_mode = 2
theme_type_variation = &"LabelCaption"
text = "Details"
text_overrun_behavior = 3

[node name="Tertiary" type="Button" parent="Row"]
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"PaperButton"
text = "Repair"
visible = false
size_flags_vertical = 4

[node name="Secondary" type="Button" parent="Row"]
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"PaperButton"
text = "Sell"
visible = false
size_flags_vertical = 4

[node name="Primary" type="Button" parent="Row"]
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"PaperButton"
text = "Buy"
size_flags_vertical = 4
