[gd_scene load_steps=1 format=3]

[node name="FallenRow" type="HBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 5

[node name="Slot" type="PanelContainer" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(20, 20)
mouse_filter = 2
theme_type_variation = &"SlotPanel"

[node name="Icon" type="TextureRect" parent="Slot"]
layout_mode = 2
mouse_filter = 2
stretch_mode = 3

[node name="Info" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = -4

[node name="Name" type="Label" parent="Info"]
layout_mode = 2
text = "Item"
text_overrun_behavior = 3

[node name="From" type="Label" parent="Info"]
layout_mode = 2
theme_type_variation = &"LabelCaption"
text = ""
text_overrun_behavior = 3

[node name="Side" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = -4

[node name="Value" type="Label" parent="Side"]
layout_mode = 2
text = "0 G"
horizontal_alignment = 2

[node name="Left" type="Label" parent="Side"]
layout_mode = 2
theme_type_variation = &"LabelCaption"
text = ""
horizontal_alignment = 2
